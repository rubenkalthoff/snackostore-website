---
interface Props { name?: string; }
const { name = 'arrow' } = Astro.props;
---
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <><path d="M5 12h14M13 6l6 6-6 6" /></>}
  {name === 'pin' && <><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></>}
  {name === 'snack' && <><path d="m6 3 3 1 3-1 3 1 3-1v18l-3-1-3 1-3-1-3 1Z"/><path d="M6 8h12M6 16h12"/><circle cx="12" cy="12" r="2"/></>}
  {name === 'drink' && <><path d="M8 3h8l-1 3 2 2v12H7V8l2-2Z"/><path d="M8 12h8M9 6h6"/></>}
  {name === 'toy' && <><path d="m12 3 9 5-9 5-9-5 9-5ZM3 8v9l9 5 9-5V8M12 13v9M7 6l9 5"/></>}
  {name === 'bottle' && <><path d="M9 2h6v5l3 4v10H6V11l3-4V2ZM9 5h6M6 13h12M6 18h12"/></>}
  {name === 'pack' && <><rect x="4" y="5" width="16" height="17" rx="2"/><path d="M4 11h16M8 5V2h3v3M14 5V2h3v3M8 16h8M8 19h5"/></>}
  {name === 'chat' && <><path d="M21 11.5a9 9 0 0 1-13 8L3 21l1.5-5A9 9 0 1 1 21 11.5Z"/><path d="M8 8c0 4 4 8 8 8l1-3-3-1-1 1-2-2 1-1-1-3Z"/></>}
</svg>
