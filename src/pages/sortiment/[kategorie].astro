---
import Layout from '../../layouts/Layout.astro';
import CategoryArtwork from '../../components/CategoryArtwork.astro';
import LiveProducts from '../../components/LiveProducts.astro';
import { categories } from '../../data/site';
export function getStaticPaths() {
  return categories.map(category => ({ params: { kategorie: category.slug }, props: { category } }));
}
const { category } = Astro.props;
const ageRestricted = ['bottle', 'pack'].includes(category.symbol);
---
<Layout title={`${category.title} in Stockheim · Snackostore`} description={`${category.title} im Snackostore Stockheim entdecken: aktuelle Produktauswahl, Preise und Bestandsstatus. Verkauf vor Ort im 24/7-Automatenstore.`}>
  {ageRestricted && <section class="wrap age-gate" data-age-gate aria-labelledby="age-title">
    <span class="age-gate-badge" aria-hidden="true">18+</span>
    <p class="eyebrow">ALTERSBESCHRÄNKTES SORTIMENT</p>
    <h1 id="age-title">Bist du mindestens<br/>18 Jahre alt?</h1>
    <p>Bitte bestätige dein Alter, um diese Produkte anzusehen.</p>
    <button class="button" type="button" data-age-confirm>Ja, ich bin mindestens 18 Jahre alt <span aria-hidden="true">→</span></button>
    <a class="catalog-back" href="/#sortiment">← Zur Kategorienübersicht</a>
    <p class="age-gate-note">Diese Selbstauskunft ersetzt keine Altersprüfung beim Kauf.</p>
    <noscript>Zum Bestätigen bitte JavaScript aktivieren. Die übrigen Kategorien kannst du ohne Bestätigung ansehen.</noscript>
  </section>}
  <div hidden={ageRestricted} data-restricted-content={ageRestricted || undefined} class={`category-page category-page-${category.symbol}`}>
    <section class="wrap catalog-hero" aria-labelledby="catalog-title">
      <div class="catalog-intro">
        <a class="catalog-back" href="/#sortiment">← Zur Kategorienübersicht</a>
        <p class="eyebrow">UNSER SORTIMENT / STOCKHEIM</p>
        <h1 id="catalog-title">{category.title}</h1>
        <p>{category.description} Entdecke unsere aktuelle Auswahl mit Preisen und Bestandsstatus.</p>
        {ageRestricted && <p class="catalog-age"><strong>18+</strong><span>Altersbeschränktes Sortiment. Verkauf ausschließlich vor Ort unter Beachtung der gesetzlichen Altersvorgaben.</span></p>}
      </div>
      <div class={`catalog-art catalog-art-${category.symbol}`}><CategoryArtwork name={category.symbol}/><span>STOCKHEIM · 24/7</span></div>
    </section>
    <div class="wrap catalog-content">
      <nav class="catalog-categories" aria-label="Sortimentskategorien">{categories.map(item => <a href={`/sortiment/${item.slug}/`} aria-current={item.slug === category.slug ? 'page' : undefined}>{item.title}</a>)}</nav>
      <LiveProducts category={category.title}/>
    </div>
  </div>
</Layout>
<script>
 const gate=document.querySelector<HTMLElement>('[data-age-gate]');
 const content=document.querySelector<HTMLElement>('[data-restricted-content]');
 if(gate&&content){
  const unlock=()=>{document.documentElement.dataset.ageConfirmed='true';content.hidden=false;gate.hidden=true;document.dispatchEvent(new Event('age-confirmed'));};
  try{if(sessionStorage.getItem('snackostore-age-confirmed')==='yes')unlock();}catch{}
  gate.querySelector('[data-age-confirm]')?.addEventListener('click',()=>{try{sessionStorage.setItem('snackostore-age-confirmed','yes');}catch{}unlock();const heading=content.querySelector<HTMLElement>('h1');heading?.setAttribute('tabindex','-1');heading?.focus();});
 }
</script>
<style is:global>
 [data-restricted-content][hidden],.age-gate[hidden]{display:none}.age-gate{padding-block:70px;min-height:65vh;max-width:850px}.age-gate-badge{display:grid;place-items:center;width:74px;height:74px;background:#bd2929;color:white;border-radius:50%;font-size:30px;font-weight:800;margin-bottom:28px}.age-gate h1{font-size:clamp(2.2rem,6vw,4rem);line-height:1.1;margin:20px 0}.age-gate>p{color:#c1c7b8}.age-gate .button{display:flex;gap:20px;margin:28px 0 18px;background:#efc466;color:#20211f;white-space:normal;text-align:left}.age-gate .age-gate-note{font-size:12px;margin-top:24px}.catalog-back{display:inline-flex!important;align-items:center;gap:12px;padding:12px 18px;border:1px solid #69725b;border-radius:999px;background:#30372a;color:#f4f3e9!important;font-size:13px!important;font-weight:700;text-decoration:none;transition:background .18s,border-color .18s}.catalog-back:hover{background:#454d38;border-color:#efc466}.catalog-back:focus-visible{outline:3px solid #efc466;outline-offset:4px}

 .category-page{padding-bottom:80px;background:#20211f}.catalog-hero{display:grid;grid-template-columns:1.5fr 1fr;gap:65px;padding-block:50px 55px;align-items:center}.catalog-back{display:inline-block;color:#c1c7b8;font-size:12px;margin-bottom:40px}.catalog-back:hover{color:#efc466}.catalog-intro h1{font-size:clamp(2.7rem,5.5vw,5rem);line-height:1.04;overflow-wrap:break-word;hyphens:auto;max-width:800px}.catalog-intro>p:not(.eyebrow){font-size:14px;color:#c1c7b8;max-width:540px;margin-top:22px}.catalog-art{background:#efc466;border-radius:18px;max-width:360px;justify-self:end;width:100%;color:#302c20;padding:20px}.catalog-art .category-art{width:100%;height:225px}.catalog-art>span{display:block;font-size:10px;font-weight:800;letter-spacing:.13em;text-align:center;padding-bottom:10px}.catalog-art-drink{background:#bbd2a4;color:#283c2c}.catalog-art-toy{background:#e6ab87;color:#613d2e}.catalog-art-bottle{background:#d3d1c5;color:#41433b}.catalog-art-pack{background:#babeb2;color:#343d34}.catalog-categories{display:flex;flex-wrap:wrap;gap:10px;border-block:1px solid #49513f;padding-block:20px}.catalog-categories a{padding:11px 16px;border:1px solid #626d52;border-radius:30px;font-size:12px;color:#d9dfcf}.catalog-categories a[aria-current=page]{background:#efc466;color:#20211f;border-color:#efc466;font-weight:750}.catalog-categories a:hover{border-color:#efc466}.catalog-content .live-products{margin-top:32px;border:0;background:transparent;padding:0;border-radius:0}.catalog-content .live-products header h2{letter-spacing:-.04em}.catalog-content .product-group h3{margin-top:32px;font-size:18px}.catalog-content .public-product{padding:24px;border-radius:12px;background:#2b3126}.catalog-content .public-product-price{color:#efc466;font-size:23px}.catalog-age{display:flex;align-items:center;gap:14px}.catalog-age strong{background:#c7262d;color:#fff;border-radius:6px;padding:10px;font-size:18px;flex-shrink:0}.catalog-age span{font-size:11px;line-height:1.6}.catalog-content .catalog-note{border-top:1px solid #49513f;padding-top:22px}

 @media(max-width:760px){.category-page{padding-bottom:55px}.catalog-hero{grid-template-columns:1fr;gap:25px;padding-block:25px 35px}.catalog-back{margin-bottom:30px}.catalog-intro h1{font-size:clamp(2.3rem,10vw,3.8rem)}.catalog-art{max-width:none;display:flex;align-items:center;padding:10px 20px;justify-content:space-between;gap:15px}.catalog-art .category-art{width:130px;height:120px;flex-shrink:0}.catalog-art>span{font-size:9px;padding:0}.catalog-categories{gap:8px;padding-block:16px}.catalog-categories a{font-size:11px;padding:10px 13px}.catalog-content .public-product{padding:18px}.catalog-content .product-controls{gap:12px}}
</style>
